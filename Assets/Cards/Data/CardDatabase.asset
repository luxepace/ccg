    shortDescription: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u0437\u043C\u0435\u0439-\u0434\u0440\u0430\u043A\u043E\u043D,
      \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0432
      \u043E\u0442\u0432\u0435\u0442 \u043D\u0430 \u0430\u0442\u0430\u043A\u0443."
    fullDescription: "\u041C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0437\u043C\u0435\u0439, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0439
      \u043B\u0435\u0442\u0430\u0442\u044C \u0438 \u043F\u043E\u0445\u0438\u0449\u0430\u0442\u044C
      \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430. \u041A\u0443\u0439\u0433\u043E\u0440\u043E\u0436
      \u0436\u0435\u0441\u0442\u043E\u043A \u0438 \u043E\u043F\u0430\u0441\u0435\u043D:
      \u043B\u044E\u0431\u043E\u0439, \u043A\u0442\u043E \u043F\u043E\u0441\u043C\u0435\u0435\u0442
      \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0440\u0443\u043A\u0443, \u0431\u0443\u0434\u0435\u0442 \u0436\u0435\u0441\u0442\u043E\u043A\u043E
      \u043D\u0430\u043A\u0430\u0437\u0430\u043D \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u043C
      \u0443\u0434\u0430\u0440\u043E\u043C \u0435\u0433\u043E \u0445\u0432\u043E\u0441\u0442\u0430
      \u0438\u043B\u0438 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u043C \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043C."
    minChapterLevel: 3
    isBaseCard: 0
  - Name: "\u041F\u0430\u043A\u0441\u044F\u0432\u0430"
    Logo: {fileID: 21300000, guid: 22b0012fbf82bd04886dd2dd94e6314c, type: 3}

    shortDescription: "\u0417\u043B\u043E\u0439 \u0434\u0443\u0445-\u0432\u0435\u043B\u0438\u043A\u0430\u043D,
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
      \u043F\u0440\u0438 \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0438."
    fullDescription: "\u0418\u0434\u0435\u043C\u0435\u0432\u0441\u044C \u2014 \u0437\u043B\u043E\u0439
      \u0434\u0443\u0445, \u0432\u0435\u043B\u0438\u043A\u0430\u043D-\u043B\u044E\u0434\u043E\u0435\u0434
      \u0438\u0437 \u043C\u043E\u0440\u0434\u043E\u0432\u0441\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u0439,
      \u0430\u043D\u0442\u0438\u043F\u043E\u0434 \u0432\u0435\u0440\u0445\u043E\u0432\u043D\u043E\u0433\u043E
      \u0431\u043E\u0433\u0430. \u041E\u043D \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043D\u0430\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0436\u0435\u0440\u0442\u0432\u0443, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
      \u0438 \u0437\u0430\u0449\u0438\u0442\u0443."
    minChapterLevel: 2
    isBaseCard: 0

    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u0411\u043E\u0433\u0438\u043D\u044F \u043F\u043E\u043B\u0435\u0439,
      \u0432\u044B\u043D\u0443\u0436\u0434\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0435\u0451."
    fullDescription: "\u041F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0437\u0435\u043C\u043B\u0435\u0434\u0435\u043B\u0438\u044F \u0438 \u0443\u0440\u043E\u0436\u0430\u044F.
      \u041E\u043D\u0430 \u043E\u0431\u0435\u0440\u0435\u0433\u0430\u0435\u0442 \u043D\u0438\u0432\u044B
      \u043E\u0442 \u0437\u043B\u0430 \u0438 \u043D\u0435\u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u0438\u043B\u044B. \u0412 \u0431\u043E\u044E \u043E\u043D\u0430 \u0432\u0441\u0442\u0430\u0435\u0442
      \u0441\u0442\u0435\u043D\u043E\u0439, \u0437\u0430\u0449\u0438\u0449\u0430\u044F
      \u0441\u0432\u043E\u0438\u0445 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432:
      \u0432\u0440\u0430\u0433\u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E \u043D\u0435\u0451,
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0438\u0432\u0448\u0438\u0441\u044C \u0441
      \u043C\u0430\u0442\u0435\u0440\u044C\u044E-\u0437\u0435\u043C\u043B\u0435\u0439."
    minChapterLevel: 1
    isBaseCard: 1

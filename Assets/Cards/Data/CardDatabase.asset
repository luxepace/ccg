    shortDescription: "\u041D\u0430\u043D\u043E\u0441\u0438\u0442 5 \u0443\u0440\u043E\u043D\u0430
      \u043E\u0434\u043D\u043E\u0439 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u043E\u0439
      \u043A\u0430\u0440\u0442\u0435."
    fullDescription: "\u041F\u0440\u0438\u0437\u044B\u0432 \u043C\u043E\u0433\u0443\u0447\u0435\u0439
      \u043C\u043E\u043B\u043D\u0438\u0438 \u043E\u0442 \u0401\u043D\u0434\u043E\u043B\u043F\u0430\u0437\u0430
      \u2014 \u0431\u043E\u0433\u0430 \u0433\u0440\u043E\u043C\u0430 \u0438 \u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F. \u041D\u0435\u0431\u0435\u0441\u043D\u044B\u0439
      \u043E\u0433\u043E\u043D\u044C \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E \u0446\u0435\u043B\u044C,
      \u0441\u0436\u0438\u0433\u0430\u044F \u0435\u0451 \u0434\u043E\u0442\u043B\u0430."
    minChapterLevel: 2
    isBaseCard: 0

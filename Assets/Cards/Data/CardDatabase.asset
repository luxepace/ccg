    TimesDealedDamage: 0
    shortDescription: "\u0425\u0438\u0442\u0440\u0430\u044F \u043F\u043B\u0443\u0442\u043E\u0432\u043A\u0430,
      \u0430\u0442\u0430\u043A\u0443\u0435\u0442 \u043F\u0440\u0438 \u0432\u044B\u0445\u043E\u0434\u0435."
    fullDescription: "\u041B\u0438\u0441\u0430-\u043F\u043E\u0432\u0438\u0442\u0443\u0445\u0430
      \u0438\u0437 \u043C\u043E\u0440\u0434\u043E\u0432\u0441\u043A\u0438\u0445 \u0441\u043A\u0430\u0437\u043E\u043A.
      \u041E\u043D\u0430 \u043D\u0435 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0438\u043B\u043E\u0439,
      \u043D\u043E \u0445\u0438\u0442\u0440\u0430 \u0438 \u0438\u0437\u0432\u043E\u0440\u043E\u0442\u043B\u0438\u0432\u0430
      \u2014 \u0432 \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044F\u0445
      \u043E\u043D\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430 \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C
      \u0434\u0430\u0436\u0435 \u043C\u0435\u0434\u0432\u0435\u0434\u044F. \u041D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0438 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D."
    minChapterLevel: 1
    isBaseCard: 1
  spells:
  - Name: "\u041C\u043E\u043B\u043D\u0438\u044F \u0401\u043D\u0434\u043E\u043B\u043F\u0430\u0437\u0430"

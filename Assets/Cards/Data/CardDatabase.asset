    shortDescription: "\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      2 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432\u0441\u0435\u043C
      \u0432\u0430\u0448\u0438\u043C \u043A\u0430\u0440\u0442\u0430\u043C."
    fullDescription: "\u041C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0432\u0435\u0442\u0435\u0440 \u043F\u0440\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0435\u0441, \u0438 \u0434\u0443\u0445\u0438
      \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0438\u0441\u0446\u0435\u043B\u044F\u044E\u0442
      \u0440\u0430\u043D\u044B \u0432\u0430\u0448\u0438\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432,
      \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u044F \u0438\u0445 \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E\u0439
      \u0441\u0438\u043B\u043E\u0439 \u0434\u0443\u0431\u0440\u0430\u0432."

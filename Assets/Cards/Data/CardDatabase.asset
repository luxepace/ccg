    shortDescription: "\u0414\u0443\u0445 \u0432\u043E\u0434\u044B, \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u0443\u0435\u0442
      \u043F\u0435\u0440\u0432\u0443\u044E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0443\u044E
      \u0430\u0442\u0430\u043A\u0443."
    fullDescription: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0432\u043E\u0434\u043D\u043E\u0439
      \u0441\u0442\u0438\u0445\u0438\u0438, \u0436\u0438\u0432\u0443\u0449\u0430\u044F
      \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445 \u043E\u043C\u0443\u0442\u0430\u0445.
      \u0415\u0451 \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043D\u0430\u0434\u0435\u0436\u043D\u043E: \u043E\u043D\u0430 \u043E\u043A\u0440\u0443\u0436\u0430\u0435\u0442
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432 \u0432\u043E\u0434\u044F\u043D\u043E\u0439
      \u043F\u0435\u043B\u0435\u043D\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F
      \u0441\u0430\u043C\u044B\u0439 \u043F\u0435\u0440\u0432\u044B\u0439 \u0438
      \u0441\u0442\u0440\u0430\u0448\u043D\u044B\u0439 \u0443\u0434\u0430\u0440 \u0432\u0440\u0430\u0433\u0430."
    minChapterLevel: 1
    isBaseCard: 0
  - Name: "\u041C\u0435\u0448\u0430\u0432\u0430"
    Logo: {fileID: 21300000, guid: f7cedc6656e0ce742bc466cadc577f7a, type: 3}
    Attack: 1
    Defense: 2
    Manacost: 2
    CanAttack: 0
    IsPlaced: 0
    Abilities: 05000000
    abilityValue: 1
    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u041F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u043F\u0447\u0435\u043B \u0438 \u043C\u0435\u0434\u0430, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435."
    fullDescription: "\u041C\u0435\u0448\u0430\u0432\u0430 (\u041C\u0435\u043A\u0448\u0430\u0432\u0430)
      \u2014 \u0431\u043E\u0433\u0438\u043D\u044F-\u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u043F\u0447\u0435\u043B\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430 \u0438
      \u0431\u043E\u0440\u0442\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430. \u0415\u0451
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0439 \u043C\u0435\u0434 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0439 \u0441\u0438\u043B\u043E\u0439,
      \u0437\u0430\u043B\u0435\u0447\u0438\u0432\u0430\u044F \u043B\u044E\u0431\u044B\u0435
      \u0440\u0430\u043D\u044B \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044F
      \u0441\u0438\u043B\u044B \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0445\u043E\u0434\u043E\u043C."
    minChapterLevel: 1
    isBaseCard: 1
  - Name: "\u041A\u0430\u0440\u0434\u0430\u0437\u0430\u0432\u0430"
    Logo: {fileID: 21300000, guid: 8bf15db4ef100244099a720d2871587a, type: 3}
    Attack: 1
    Defense: 3
    Manacost: 2
    CanAttack: 0
    IsPlaced: 0
    Abilities: 04000000
    abilityValue: 0
    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0434\u0432\u043E\u0440\u0430,
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0443\u0434\u0430\u0440\u044B
      \u043D\u0430 \u0441\u0435\u0431\u044F."
    fullDescription: "\u041A\u0430\u0440\u0434\u0430\u0437\u0430\u0432\u0430 (\u041A\u0430\u043B\u0434\u0430\u0437\u0430\u0432\u0430)
      \u2014 \u0434\u0443\u0445-\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0434\u0432\u043E\u0440\u0430 \u0438 \u0445\u043B\u0435\u0432\u0430. \u041E\u043D\u0430
      \u043E\u0431\u0435\u0440\u0435\u0433\u0430\u0435\u0442 \u0434\u043E\u043C \u0438
      \u0441\u043A\u043E\u0442 \u043E\u0442 \u043D\u0435\u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u0438\u043B\u044B, \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0441\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F
      \u0441 \u043D\u0435\u0439, \u043F\u043E\u043A\u0430 \u0445\u043E\u0437\u044F\u0435\u0432\u0430
      \u0441\u043F\u0430\u0441\u0430\u044E\u0442 \u0441\u0432\u043E\u0435 \u0434\u043E\u0431\u0440\u043E."
    minChapterLevel: 1
    isBaseCard: 1
  - Name: "\u041C\u0435\u0434\u0432\u0435\u0434\u044C (\u041E\u0432\u0442\u043E)"
    Logo: {fileID: 21300000, guid: 4e5676d672e6f3844acf68397d7eba8e, type: 3}
    Attack: 3
    Defense: 4
    Manacost: 3
    CanAttack: 0
    IsPlaced: 0
    Abilities: 04000000
    abilityValue: 0
    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u0422\u043E\u0442\u0435\u043C\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043E\u043A,
      \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432."
    fullDescription: "\u041C\u0435\u0434\u0432\u0435\u0434\u044C \u0432 \u043C\u043E\u0440\u0434\u043E\u0432\u0441\u043A\u043E\u0439
      \u043C\u0438\u0444\u043E\u043B\u043E\u0433\u0438\u0438 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u0442\u0435\u043C\u043D\u044B\u043C \u043F\u0435\u0440\u0432\u043E\u043F\u0440\u0435\u0434\u043A\u043E\u043C
      \u043D\u0430\u0440\u043E\u0434\u0430. \u041E\u043D \u0434\u043E\u0431\u0440\u043E\u0434\u0443\u0448\u0435\u043D
      \u0438 \u043D\u0435\u0443\u043A\u043B\u044E\u0436 \u0432 \u043C\u0438\u0440\u043D\u043E\u0439
      \u0436\u0438\u0437\u043D\u0438, \u043D\u043E \u0432 \u0431\u043E\u044E \u0432\u0441\u0442\u0430\u0435\u0442
      \u0441\u0442\u0435\u043D\u043E\u0439, \u0437\u0430\u0449\u0438\u0449\u0430\u044F
      \u0431\u043E\u043B\u0435\u0435 \u0441\u043B\u0430\u0431\u044B\u0445 \u0441\u043E\u0440\u043E\u0434\u0438\u0447\u0435\u0439
      \u043E\u0442 \u043B\u044E\u0431\u043E\u0439 \u043D\u0430\u043F\u0430\u0441\u0442\u0438."
    minChapterLevel: 1
    isBaseCard: 1
  - Name: "\u041C\u043E\u0440\u0434\u043E\u0432\u0441\u043A\u0438\u0439 \u0432\u043E\u0438\u043D"

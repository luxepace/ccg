  fieldCards:
  - Name: "\u0422\u044E\u0448\u0442\u044F"
    Logo: {fileID: 0}
    Attack: 4
    Defense: 3
    Manacost: 4
    CanAttack: 0
    IsPlaced: 0
    Abilities: 02000000
    abilityValue: 1
    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439
      \u0446\u0430\u0440\u044C \u043C\u043E\u0440\u0434\u0432\u044B, \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B \u0437\u0430 \u0445\u043E\u0434."
    fullDescription: "\u0422\u044E\u0448\u0442\u044F \u2014 \u0432\u0435\u043B\u0438\u043A\u0438\u0439
      \u044D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0433\u0435\u0440\u043E\u0439
      \u0438 \u0446\u0430\u0440\u044C (\u0438\u043D\u044F\u0437\u043E\u0440). \u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E
      \u043F\u0440\u0435\u0434\u0430\u043D\u0438\u044F\u043C, \u043E\u043D \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u043B
      \u0440\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u043D\u044B\u0435 \u043F\u043B\u0435\u043C\u0435\u043D\u0430
      \u0438 \u0432\u0435\u043B \u0438\u0445 \u0432 \u0431\u0438\u0442\u0432\u0430\u0445.
      \u0415\u0433\u043E \u0441\u0438\u043B\u0430 \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u043C
      \u0443\u0434\u0430\u0440\u0435: \u043E\u043D \u0431\u044C\u0435\u0442 \u0432\u0440\u0430\u0433\u0430
      \u0442\u0430\u043A \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0438 \u043C\u043E\u0449\u043D\u043E, \u0447\u0442\u043E \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0431\u0443\u0434\u0442\u043E \u0443\u0434\u0430\u0440\u043E\u0432 \u0434\u0432\u0430."
    minChapterLevel: 2
    isBaseCard: 0
  - Name: "\u0412\u0438\u0440\u044F\u0432\u0430"
    Logo: {fileID: 21300000, guid: fb21554180f5a7544b5f16cf324e217e, type: 3}
    Attack: 2
    Defense: 4
    Manacost: 3
    CanAttack: 0
    IsPlaced: 0
    Abilities: 05000000
    abilityValue: 2
    IsSpell: 0
    TimesDealedDamage: 0
    shortDescription: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043B\u0435\u0441\u0430,
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0445\u043E\u0434."
    fullDescription: "\u0412\u0438\u0440\u044F\u0432\u0430 \u2014 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u043E
      \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E \u0440\u043E\u0434\u0430,
      \u0445\u043E\u0437\u044F\u0439\u043A\u0430 \u043B\u0435\u0441\u0430 \u0438
      \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u0430
      \u0435\u0433\u043E \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u0439,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432 \u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
      \u043F\u043E\u0432\u0435\u0440\u044C\u044F\u0445 \u043D\u0435 \u0438\u043C\u0435\u0435\u0442
      \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u043A\u0430\u043D\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043E\u0431\u043B\u0438\u043A\u0430 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u0430
      \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F, \u043D\u043E \u0447\u0430\u0449\u0435
      \u0432\u0441\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0435\u0442
      \u0432 \u0432\u0438\u0434\u0435 \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0439,
      \u0437\u0430\u0440\u043E\u0441\u0448\u0435\u0439 \u0432\u043E\u043B\u043E\u0441\u0430\u043C\u0438
      \u0436\u0435\u043D\u0449\u0438\u043D\u044B \u0440\u043E\u0441\u0442\u043E\u043C
      \u0441 \u0434\u0435\u0440\u0435\u0432\u043E \u0438\u043B\u0438 \u0432\u0435\u043B\u0438\u043A\u0430\u043D\u0448\u0438
      \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438 \u0442\u0435\u043C\u043D\u044B\u043C\u0438
      \u0432\u043E\u043B\u043E\u0441\u0430\u043C\u0438, \u0431\u0440\u043E\u0434\u044F\u0449\u0435\u0439
      \u043F\u043E \u0447\u0430\u0449\u0435 \u0438 \u043B\u043E\u043C\u0430\u044E\u0449\u0435\u0439
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043F\u0443\u0433\u0430\u044E\u0449\u0438\u0439 \u0438 \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u2014 \u043E\u043D\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0437\u0430\u0432\u0435\u0441\u0442\u0438 \u043F\u0443\u0442\u043D\u0438\u043A\u0430
      \u0432 \u043D\u0435\u043F\u0440\u043E\u043B\u0430\u0437\u043D\u0443\u044E \u0447\u0430\u0449\u0443
      \u0438\u043B\u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u0442\u044C \u0434\u043E
      \u0441\u043C\u0435\u0440\u0442\u0438, \u2014 \u0412\u0438\u0440\u044F\u0432\u0430
      \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043B\u0438\u0442 \u043A \u0442\u0435\u043C,
      \u043A\u0442\u043E \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043A \u043F\u0440\u0438\u0440\u043E\u0434\u0435, \u043F\u043E\u043C\u043E\u0433\u0430\u044F
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u044F\u0433\u043E\u0434\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044F
      \u0443\u0434\u0430\u0447\u043D\u043E\u0439 \u043E\u0445\u043E\u0442\u0435,
      \u0430 \u0432 \u043C\u043E\u0440\u0434\u043E\u0432\u0441\u043A\u043E\u043C
      \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435 \u0435\u0451 \u043E\u0431\u0440\u0430\u0437
      \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E \u0432\u043E\u043F\u043B\u043E\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445
      \u0441\u043A\u0443\u043B\u044C\u043F\u0442\u0443\u0440\u0430\u0445 \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u044F\u043C\u0438,
      \u0433\u0434\u0435 \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0430
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043D\u043E\u0433\u0438
      \u0432 \u043B\u0430\u043F\u0442\u044F\u0445 \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0442\u0441\u044F
      \u0441 \u0430\u0440\u0445\u0435\u0442\u0438\u043F\u043E\u043C \u0441\u0442\u0440\u043E\u0433\u043E\u0439
      \u043C\u0430\u0442\u0435\u0440\u0438-\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0438\u0446\u044B."
    minChapterLevel: 1
    isBaseCard: 1
  - Name: "\u041A\u0443\u0439\u0433\u043E\u0440\u043E\u0436"
    Logo: {fileID: 0}

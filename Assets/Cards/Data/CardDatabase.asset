    TimesDealedDamage: 0
    shortDescription: "\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043E\u043F\u043E\u043B\u0447\u0435\u043D\u0435\u0446,
      \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A \u0440\u043E\u0434\u043D\u043E\u0439
      \u0437\u0435\u043C\u043B\u0438."
    fullDescription: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0432\u0441\u0442\u0430\u0432\u0448\u0438\u0439 \u043F\u043E\u0434 \u0440\u0443\u0436\u044C\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044C
      \u0441\u0432\u043E\u044E \u0437\u0435\u043C\u043B\u044E, \u0441\u0435\u043C\u044C\u044E
      \u0438 \u0440\u043E\u0434\u043D\u044B\u0435 \u043B\u0435\u0441\u0430 \u043E\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u043D\u0435\u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u0438\u043B\u044B. \u041D\u0435 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u043C\u0430\u0433\u0438\u0435\u0439, \u043D\u043E \u0441\u043B\u0430\u0432\u0438\u0442\u0441\u044F
      \u0441\u0432\u043E\u0435\u0439 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C\u044E
      \u0438 \u043E\u0442\u0432\u0430\u0433\u043E\u0439."
    minChapterLevel: 1
    isBaseCard: 1
  - Name: "\u041B\u0438\u0441\u0430 (\u0420\u0438\u0448)"
    Logo: {fileID: 21300000, guid: c5f340a66aebe7644b5da347fa3eca41, type: 3}
    Attack: 1
    Defense: 1
